# Copy to .env to override. Every value here is optional.

# Ports on your machine.
WEB_PORT=3000
API_PORT=8080
DB_PORT=5544

# Local development database password (not a secret; the database is local only).
DB_PASSWORD=rates

# Transparency in Coverage index (table of contents) to read rate-file links from.
# Leave empty to use the Fidelis index named in the assignment.
INDEX_URL=

# Picks the reporting structure whose plan names contain this text.
# Leave empty for the default, "Ambetter" (the 89 MB file).
PLAN_NAME_CONTAINS=
